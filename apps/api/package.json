{
  "name": "@jengaflow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "echo \"Linting will be enabled with the shared ESLint configuration\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "migration:run": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:run",
    "migration:show": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:show",
    "seed:demo": "ts-node -r tsconfig-paths/register src/database/seeds/demo.seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27",
    "ioredis": "^5.6.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "cookie-parser": "^1.4.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "jest": "^30.1.3",
    "ts-jest": "^29.4.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typeorm-ts-node-commonjs": "^0.3.20",
    "typescript": "~5.9.3",
    "@types/cookie-parser": "^1.4.9"
  }
}
