# JengaFlow by Qwerty Systems - Coolify environment template.
# Configure these values in Coolify's Environment Variables. Do not commit secrets.

NODE_ENV=production
APP_NAME=JengaFlow
APP_URL=https://jengaflow.qwerty.co.ke
API_PUBLIC_URL=https://api.jengaflow.qwerty.co.ke
CORS_ALLOWED_ORIGINS=https://jengaflow.qwerty.co.ke
API_PORT=3001
WEB_PORT=80
PLATFORM_BASE_DOMAIN=qwerty.co.ke
TENANT_BASE_DOMAIN=qwerty.co.ke
TENANT_SUBDOMAIN_SUFFIX=qwerty.co.ke
CONTROL_PLANE_DOMAIN=control.qwerty.co.ke

# Existing managed PostgreSQL (Coolify resource / external service).
DATABASE_URL=
DATABASE_HOST=157.245.160.198
DATABASE_PORT=2828
DATABASE_USERNAME=jengaflow_app # runtime least-privilege role; do not use postgres for the API
DATABASE_PASSWORD=SET_THIS_IN_COOLIFY
DATABASE_NAME=JengaFlow
DATABASE_SSL=false # Coolify database screenshot shows SSL disabled
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_CONNECT_TIMEOUT_MS=10000

# Existing managed Redis. Use rediss:// when TLS is enabled.
REDIS_URL=rediss://:PASSWORD@REDIS_HOST:6379/0
REDIS_TLS=true
REDIS_KEY_PREFIX=jengaflow:
REDIS_CONNECT_TIMEOUT_MS=10000

# Google Identity Services OAuth 2.0 Web client ID. Configure authorized JS origins in Google Cloud Console.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
VITE_API_BASE_URL=
SWAGGER_ENABLED=false

# Generate independent long random secrets; never reuse between environments.
JWT_ACCESS_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_64_PLUS_RANDOM_CHARACTERS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=.qwerty.co.ke
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

# SeaweedFS S3-compatible object storage.
STORAGE_DRIVER=seaweedfs
SEAWEEDFS_ENDPOINT=s3.qwerty.co.ke
SEAWEEDFS_PORT=443
SEAWEEDFS_USE_SSL=true
SEAWEEDFS_BUCKET=jenga-flow
SEAWEEDFS_PUBLIC_URL=https://s3.qwerty.co.ke/jenga-flow
SEAWEEDFS_ACCESS_KEY=
SEAWEEDFS_SECRET_KEY=

# S3-compatible aliases for libraries configured with standard AWS SDK variables.
S3_ENDPOINT=https://s3.qwerty.co.ke
S3_REGION=us-east-1
S3_BUCKET=jenga-flow
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Encrypted PostgreSQL backups to a dedicated SeaweedFS backup prefix.
BACKUP_ENABLED=true
BACKUP_CRON=0 2 * * *
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_PUBLIC_RECIPIENT_KEY
BACKUP_RETENTION_DAYS=35

# Defaults for newly provisioned Kenyan tenants.
DEFAULT_COUNTRY=KE
DEFAULT_CURRENCY=KES
DEFAULT_TIMEZONE=Africa/Nairobi
DEFAULT_LANGUAGE=en

# Optional transactional email.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=JengaFlow <no-reply@qwerty.co.ke>

# Optional monitoring.
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
LOG_LEVEL=info

# Optional standalone site mode only (docker-compose.local.yml).
LOCAL_DATABASE_NAME=jengaflow
LOCAL_DATABASE_USER=jengaflow
LOCAL_DATABASE_PASSWORD=replace-with-a-long-local-db-password
LOCAL_REDIS_PASSWORD=replace-with-a-long-local-redis-password
