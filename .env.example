# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
APP_NAME=CrewLedger by Qwerty Systems
APP_URL=http://localhost:8080
API_PORT=3001
WEB_PORT=8080
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=crewledger
# Administrative bootstrap account is used only by the Postgres container initialization.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=replace-with-a-strong-admin-password
# Runtime/migration account is deliberately not a PostgreSQL superuser and cannot bypass RLS.
DATABASE_USER=crewledger_app
DATABASE_PASSWORD=replace-with-a-strong-url-safe-app-password
DATABASE_URL=postgresql://crewledger_app:replace-with-a-strong-url-safe-app-password@localhost:5432/crewledger
JWT_ACCESS_SECRET=replace-with-a-long-random-development-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-development-secret
DEFAULT_CURRENCY=KES
DEFAULT_TIMEZONE=Africa/Nairobi
