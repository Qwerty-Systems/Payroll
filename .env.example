# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
APP_NAME=Qwerty Construction Payroll
APP_URL=http://localhost:8080
API_PORT=3001
WEB_PORT=8080
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=construction_payroll
DATABASE_USER=payroll_app
DATABASE_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://payroll_app:change-this-local-password@localhost:5432/construction_payroll
JWT_ACCESS_SECRET=replace-with-a-long-random-development-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-development-secret
DEFAULT_CURRENCY=KES
DEFAULT_TIMEZONE=Africa/Nairobi
